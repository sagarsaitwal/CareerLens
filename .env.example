# CareerLens — environment template
#
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Secrets must exist only here, never in code, logs, audit records,
# snapshots or error messages.

# ---------- PostgreSQL (source of truth) ----------
POSTGRES_USER=careerlens
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=careerlens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full URL used by the application. Host/port are configurable so
# PostgreSQL can later move to a separate machine without code changes.
DATABASE_URL=postgresql+psycopg://careerlens:change-me-in-your-local-env@postgres:5432/careerlens

# ---------- Redis (queue / cache / locks — NOT durable state) ----------
REDIS_URL=redis://redis:6379/0
# Memory cap matters on the 4 GB minimum target.
REDIS_MAXMEMORY=192mb

# ---------- Application ----------
APP_ENV=development
LOG_LEVEL=INFO
# Conservative worker count for the 4 GB minimum target.
UVICORN_WORKERS=2

# ---------- AI provider ----------
# The application must not depend directly on a single vendor.
# Leave AI_PROVIDER=none until Milestone 8.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# ---------- Version axes ----------
# rule_version and model_version are set in code (app/core/versions.py).
# catalog_version advances with catalog data migrations.

# ---------- Testing ----------
# Integration tests require a real PostgreSQL. SQLite is never used.
#
# This value is the CONTAINER view, because `make test-backend` runs
# pytest inside the api container. From a WSL2 shell outside the
# containers, the same database is reachable at localhost:5433.
TEST_DATABASE_URL=postgresql+psycopg://careerlens:change-me-in-your-local-env@postgres_test:5432/careerlens_test
